<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Job identifier -->
    <key>Label</key>
    <string>com.kalshi.weatherbot</string>

    <!-- What to run.
         This TEMPLATE is paper mode (--dry-run): it runs the full pipeline —
         settlement checks, re-verification against official GHCND truth,
         retraining, decision logging — but simulates the orders. To trade
         real money, remove the --dry-run line AND ensure config.py + the API
         key are present. (The author's installed copy runs live; keep
         config.RUN_HOUR equal to the Hour below.) -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/kalshi-bot/venv/bin/python</string>
        <string>/Users/YOUR_USERNAME/kalshi-bot/scheduler.py</string>
        <string>run</string>
        <string>--dry-run</string>
        <!-- Sizing is percentage-of-bankroll (config.py: MAX_RUN_EXPOSURE_PCT).
             Add "--max-spend N" back here only if you want a hard dollar
             ceiling on top; fixed caps clip whichever order sizes last and
             can unbalance hedged bracket pairs. -->
    </array>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/kalshi-bot</string>

    <!-- Run daily at 13:00 local time. Tomorrow's markets and the 12z model
         runs are available by then; the learning step runs first (~1 min),
         then trading. Keep config.RUN_HOUR in sync. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>13</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Stdout/stderr logging -->
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/kalshi-bot/logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/kalshi-bot/logs/launchd_stderr.log</string>

    <!-- Environment variables (ensure Python can find modules) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/YOUR_USERNAME/kalshi-bot/venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/YOUR_USERNAME/kalshi-bot</string>
    </dict>

    <!-- Don't restart if it crashes — we only want one run per day -->
    <key>KeepAlive</key>
    <false/>

    <!-- Process niceness (don't hog CPU) -->
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
